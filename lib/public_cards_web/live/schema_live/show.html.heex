<Layouts.app flash={@flash}>
  <.header>
    {@type.label || @type.id}
    <:subtitle>
      <span class="font-mono text-sm">{@type.id}</span>
    </:subtitle>
    <:actions>
      <.button navigate={~p"/schema"}>
        <.icon name="hero-arrow-left" /> Back to Types
      </.button>
    </:actions>
  </.header>

  <div class="mt-6 space-y-8">
    <section>
      <h2 class="text-lg font-semibold text-slate-900">Description</h2>
      <p class="mt-2 text-slate-600">
        {@type.comment || "No description available."}
      </p>
    </section>

    <section :if={@type.subclass_of}>
      <h2 class="text-lg font-semibold text-slate-900">Parent Type</h2>
      <p class="mt-2">
        <.link
          navigate={~p"/schema/#{@type.subclass_of}"}
          class="text-slate-600 hover:text-slate-900 font-mono text-sm"
        >
          {@type.subclass_of}
        </.link>
      </p>
    </section>

    <section>
      <h2 class="text-lg font-semibold text-slate-900">
        Properties
        <span class="text-sm font-normal text-slate-500">
          ({length(@properties)})
        </span>
      </h2>

      <div class="mt-4 overflow-hidden rounded-lg border border-slate-200">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th
                scope="col"
                class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"
              >
                Property
              </th>
              <th
                scope="col"
                class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"
              >
                Expected Type
              </th>
              <th
                scope="col"
                class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider hidden lg:table-cell"
              >
                Description
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-slate-200">
            <tr
              :for={prop <- @properties}
              class="hover:bg-slate-50"
            >
              <td class="px-4 py-3 text-sm">
                <div class="font-medium text-slate-900">
                  {prop.label || prop.id}
                </div>
                <div class="text-xs text-slate-500 font-mono">
                  {prop.id}
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-slate-600">
                <div class="flex flex-wrap gap-1">
                  <span
                    :for={range <- prop.range || []}
                    class="inline-flex items-center rounded bg-slate-100 px-2 py-0.5 text-xs font-mono"
                  >
                    {range}
                  </span>
                  <span
                    :if={prop.range == [] || prop.range == nil}
                    class="text-slate-400"
                  >
                    Any
                  </span>
                </div>
              </td>
              <td class="px-4 py-3 text-sm text-slate-600 hidden lg:table-cell max-w-md">
                <p class="line-clamp-2">
                  {prop.comment || ""}
                </p>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <p
        :if={@properties == []}
        class="mt-4 text-slate-500 text-sm"
      >
        No properties defined for this type.
      </p>
    </section>

    <section class="border-t border-slate-200 pt-6">
      <h2 class="text-lg font-semibold text-slate-900">Quick Start</h2>
      <p class="mt-2 text-sm text-slate-600">
        Create a new card with this schema type:
      </p>
      <div class="mt-3">
        <.button
          variant="primary"
          navigate={~p"/cards/new?type=#{@type.id}"}
        >
          <.icon name="hero-plus" /> Create {@type.label || @type.id} Card
        </.button>
      </div>
    </section>
  </div>
</Layouts.app>
